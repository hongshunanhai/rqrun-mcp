{
  "name": "@local/rqrun-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "displayName": "RQrun 训练数据",
  "description": "把 RQrun 的训练记录、训练负荷与跑力接入对话，让 agent 直接分析你的跑步数据。",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["cordis.patch.yml", "locale/*.json", "icon.svg"],
